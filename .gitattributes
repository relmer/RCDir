# Auto-detect text files and normalize line endings
* text=auto

# Rust source files
*.rs text diff=rust

# Common text files
*.md text
*.toml text
*.json text
*.yml text
*.yaml text

# Scripts
*.ps1 text eol=crlf
*.sh text eol=lf

# Prevent accidental binary diffs
*.exe binary
*.dll binary
*.pdb binary

# Spec Kit records a SHA-256 of each file it installs and treats any mismatch
# as a local edit. Those hashes are of LF files, so a CRLF checkout makes every
# managed file look modified and forces an upgrade to use --force. These rules
# come last so they override *.ps1 eol=crlf above.
.specify/**        text eol=lf
.claude/skills/**  text eol=lf
.github/agents/**  text eol=lf
.github/prompts/** text eol=lf
